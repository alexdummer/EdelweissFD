# The kernel sources are not referenced by setup.py when EdelweissFE is absent at sdist time,
# so setuptools would leave them out and an install from the sdist could never compile them.
recursive-include edelweissfd *.pyx
graft tests
graft examples
include CONTRIBUTING.md
global-exclude *.py[cod] *.so __pycache__
global-exclude edelweissfd/kernels/*.cpp edelweissfd/kernels/*.html
